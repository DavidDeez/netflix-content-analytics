# Git ignore rules for Netflix Content Analytics

# Raw and intermediate dataset files (do not redistribute raw CSVs in Git)
data/*.csv
data/*.zip
data/*.parquet
!data/README.md

# Python byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE and OS artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
